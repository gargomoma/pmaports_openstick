# Forked from Alpine to link to libsystemd instead of libelogind
maintainer="Aster Boese <asterboese@mailbox.org>"
pkgname=seatd
_pkgver=0.9.3
pkgver=9999.$_pkgver
pkgrel=0
pkgdesc="Minimal seat management daemon"
url="https://sr.ht/~kennylevinsen/seatd/"
license="MIT"
# ppc64le: original APKBUILD uses conditional compilation to silence an error
arch="all !ppc64le"
pkggroups="seat"
install="$pkgname.pre-install $pkgname.post-install $pkgname.post-upgrade"
makedepends="meson scdoc systemd-dev linux-headers"
subpackages="libseat:libs libseat-dev"
source="$pkgname-$_pkgver.tar.gz::https://git.sr.ht/~kennylevinsen/seatd/archive/$_pkgver.tar.gz"
builddir="$srcdir/$pkgname-$_pkgver"

# secfixes:
#   0.6.2-r0:
#     - CVE-2021-41387

build() {
	abuild-meson \
		-Dlibseat-logind=systemd \
		-Dman-pages=disabled \
		. output

	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	# This is an suid program that is part of a separate subpackage, so it can be
	# pulled from Alpine's repos instead. Removing this allows unmarking the
	# package as requiring suid.
	rm "$pkgdir"/usr/bin/seatd-launch
}

libs() {
	default_libs
	pkgdesc="Universal seat management library"
}

dev() {
	default_dev
	pkgdesc="Universal seat management library (development files)"
}

sha512sums="
8cb21cfbd9aa25966fe3f586de75d24a8625142ffb49e6ec357875c347d3e92d535467b817d79fdc704f80858a145f1107c488adbf22a1c337dbc6ccccc8b00a  seatd-0.9.3.tar.gz
"
