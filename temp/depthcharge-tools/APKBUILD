# Forked from Alpine for testing. DO NOT MERGE!
maintainer="Ingo Reitz <9l@9lo.re>"
pkgname=depthcharge-tools
pkgver=9993
pkgrel=0
pkgdesc="Tools to manage the Chrome OS bootloader"
url="https://gitlab.postmarketos.org/postmarketOS/depthcharge-tools"
# other arches blocked by vboot-utils
arch="armhf armv7 aarch64 x86_64 x86"
license="GPL-2.0-or-later"
depends="
	cgpt
	dtc
	gzip
	lz4
	py3-packaging
	py3-importlib-metadata
	py3-importlib-resources
	u-boot-tools
	vboot-utils
	xz
"
makedepends="
	py3-gpep517
	py3-installer
	py3-setuptools
"
_commit="3ae5d8f5efac82bf23cbb1842d1879307d8e4d9f"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://gitlab.postmarketos.org/9lore/depthcharge-tools/-/archive/$_commit/depthcharge-tools-$_commit.tar.gz"
options="!check"
builddir="$srcdir/$pkgname-$_commit"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
