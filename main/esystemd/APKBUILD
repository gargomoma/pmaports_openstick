# Co-Maintainer: Ferass El Hafidi <funderscore@postmarketos.org>
maintainer="Aster Boese <asterboese@mailbox.org>"
pkgname=esystemd
pkgver=261.2
pkgrel=2
_pkgname="systemd"
_pkgver="${pkgver/_/-}"
pkgdesc="systemd meta package for OpenRC-specific binaries and configs"
url="https://github.com/systemd/systemd"
arch="all"
license="MIT AND GPL-2.0-only AND LGPL-2.1-or-later"
makedepends_build="
	meson
	coreutils
	gperf
	kmod
	py3-jinja2
	bash
	"
makedepends_host="
	dbus-dev<9990
	kmod-dev
	libblkid
	libcap
	libcap-dev
	libintl
	libucontext-dev
	musl-libintl
	util-linux
	util-linux-dev
	"
subpackages="
	$pkgname-sysusers-openrc:standalone_sysusers_openrc
	$pkgname-sysusers:standalone
	$pkgname-tmpfiles-openrc:standalone_tmpfiles_openrc
	$pkgname-tmpfiles:standalone
	$pkgname-udevd-openrc:udevd_openrc
	$pkgname-udevd
	"
source="systemd-$pkgver.tar.gz::https://github.com/systemd/systemd/archive/refs/tags/v$_pkgver.tar.gz
	$_pkgname-sysusers.initd
	$_pkgname-tmpfiles-clean.initd
	$_pkgname-tmpfiles-setup-dev-early.initd
	$_pkgname-tmpfiles-setup-dev.initd
	$_pkgname-tmpfiles-setup.initd
	$_pkgname-udevd-postmount.initd
	"
triggers="
	$pkgname-sysusers.trigger=/usr/lib/sysusers.d
	$pkgname-tmpfiles.trigger=/usr/lib/tmpfiles.d
	$pkgname-udevd.trigger=/usr/lib/udev/rules.d
	"
# Any libraries, if they are eventually added, should not conflict or provide
# the main systemd package versions and cause esystemd to be installed instead
sonameprefix="$pkgname:"
options="!check pmb:cross-native2"
builddir="$srcdir/$_pkgname-$_pkgver"

build() {
	# logind is only enabled to enable the udev rules
	abuild-meson \
		-Dtests=false \
		-Ddbuspolicydir=/usr/share/dbus-1/system.d \
		-Ddbussessionservicedir=/usr/share/dbus-1/services \
		-Ddbussystemservicedir=/usr/share/dbus-1/system-services \
		-Dbashcompletiondir=no \
		-Dzshcompletiondir=no \
		\
		-Dmode=release \
		-Dsplit-bin=true \
		-Dlibc=musl \
		-Dstandalone-binaries=true \
		\
		-Dkmod-path=/bin/kmod \
		-Dsulogin-path=/sbin/sulogin \
		\
		-Dwheel-group=false \
		-Dadm-group=false \
		-Ddebug-shell=/bin/ash \
		\
		-Dbootloader=disabled \
		-Dukify=disabled \
		-Dutmp=false \
		-Dldconfig=false \
		-Duserdb=false \
		-Dhomed=disabled \
		-Dnss-myhostname=false \
		-Dnss-mymachines=disabled \
		-Dnss-resolve=disabled \
		-Dnss-systemd=false \
		-Dsysext=false \
		-Dsysusers=true \
		-Dselinux=disabled \
		-Dinstall-sysconfdir=false \
		\
		-Dsystem-alloc-uid-min=101 \
		-Dsystem-alloc-gid-min=101 \
		-Dsystem-uid-max=999 \
		-Dsystem-gid-max=999 \
		-Dnobody-user=nobody \
		-Dnobody-group=nobody \
		\
		-Ddefault-kill-user-processes=true \
		-Dgshadow=false \
		-Ddefault-locale=en_US.UTF-8 \
		\
		-Didn=false \
		-Dsysvinit-path="" \
		\
		-Dbacklight=false \
		-Dbinfmt=false \
		-Dcoredump=false \
		-Dfirstboot=false \
		-Dhibernate=false \
		-Dhostnamed=false \
		-Dhwdb=false \
		-Dinitrd=false \
		-Dkernel-install=false \
		-Dlocaled=false \
		-Dlogind=true \
		-Dmachined=false \
		-Dmountfsd=false \
		-Dnetworkd=false \
		-Dnspawn=disabled \
		-Dnsresourced=false \
		-Doomd=false \
		-Dportabled=false \
		-Dpstore=false \
		-Dquotacheck=false \
		-Drandomseed=false \
		-Drepart=false \
		-Dresolve=false \
		-Drfkill=false \
		-Dsysinstall=false \
		-Dstoragetm=false \
		-Dtimedated=false \
		-Dtimesyncd=false \
		-Dtmpfiles=true \
		-Dvconsole=false \
		-Dxdg-autostart=false \
		-Dtpm=false \
		build .
	meson compile ${JOBS:+-j ${JOBS}} -C build
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C build

	# Save binaries from when files that cannot be disabled at build-time are
	# deleted
	mv "$pkgdir"/usr/bin/systemd-sysusers.standalone \
		"$pkgdir"/
	mv "$pkgdir"/usr/bin/systemd-tmpfiles.standalone \
		"$pkgdir"/
	mv "$pkgdir"/usr/bin/udevadm \
		"$pkgdir"/
	mv "$pkgdir"/usr/lib/udev \
		"$pkgdir"/

	# Save libudev so we can provide eudev-libs
	mv "$pkgdir"/usr/lib/libudev.so* \
		"$pkgdir"/

	# Save shared library for usage by udev
	mv "$pkgdir"/usr/lib/systemd/libsystemd-shared-* \
		"$pkgdir"/

	# Only save basic.conf since the rest of the configs are systemd-
	# specific
	mv "$pkgdir"/usr/lib/sysusers.d/basic.conf \
		"$pkgdir"/

	# Save default configs that are relevant on OpenRC
	local tmpfiles_configs="
			credstore.conf
			etc.conf
			home.conf
			provision.conf
			root.conf
			static-nodes-permissions.conf
			tmp.conf
			var.conf
			x11.conf
	"
	for file in $tmpfiles_configs; do
		mv "$pkgdir"/usr/lib/tmpfiles.d/"$file" \
			"$pkgdir"/
	done

	rm -r "$pkgdir"/usr
	rm -r "$pkgdir"/var

	mkdir -p "$pkgdir"/usr/bin
	mv "$pkgdir"/systemd* \
		"$pkgdir"/usr/bin/
	mv "$pkgdir"/udevadm \
		"$pkgdir"/usr/bin/

	mkdir -p "$pkgdir"/usr/lib/
	mv "$pkgdir"/udev \
		"$pkgdir"/usr/lib/

	mv "$pkgdir"/libudev.so* \
		"$pkgdir"/usr/lib/

	mkdir -p "$pkgdir"/usr/lib/systemd
	mv "$pkgdir"/libsystemd-shared-* \
		"$pkgdir"/usr/lib/systemd/

	mkdir -p "$pkgdir"/usr/lib/sysusers.d
	mv "$pkgdir"/basic.conf \
		"$pkgdir"/usr/lib/sysusers.d/

	mkdir -p "$pkgdir"/usr/lib/tmpfiles.d
	for file in $tmpfiles_configs; do
		mv "$pkgdir"/"$file" \
			"$pkgdir"/usr/lib/tmpfiles.d/
	done

	# install OpenRC service files for standalone binaries
	for i in clean setup-dev-early setup-dev setup; do
		install -Dm755 "$srcdir"/systemd-tmpfiles-"$i".initd \
			"$pkgdir"/etc/init.d/systemd-tmpfiles-"$i"
	done
	install -Dm755 "$srcdir"/systemd-sysusers.initd \
		"$pkgdir"/etc/init.d/systemd-sysusers
	install -Dm755 "$srcdir"/systemd-udevd-postmount.initd \
		"$pkgdir"/etc/init.d/systemd-udevd-postmount
}

standalone() {
	local binary="${subpkgname##*-}"
	pkgdesc="systemd-$binary (standalone)"
	# shouldn't be installed with systemd proper
	depends="!systemd $pkgname=$pkgver-r$pkgrel libucontext"

	local install_dir="usr/bin"
	amove "$install_dir"/systemd-"$binary".standalone
	ln -s systemd-"$binary".standalone \
		"$subpkgdir"/"$install_dir"/"$_pkgname"-"$binary"
}

standalone_sysusers_openrc() {
	pkgdesc="systemd-sysusers (standalone) (OpenRC init scripts)"
	install_if="$pkgname-sysusers=$pkgver-r$pkgrel openrc"

	amove etc/init.d/systemd-sysusers
}

standalone_tmpfiles_openrc() {
	pkgdesc="systemd-tmpfiles (standalone) (OpenRC init scripts)"
	install_if="$pkgname-tmpfiles=$pkgver-r$pkgrel openrc"

	amove etc/init.d/systemd-tmpfiles*
}

udevd_openrc() {
	pkgdesc="systemd udev packaged alone"
	install_if="$pkgname-udevd=$pkgver-r$pkgrel openrc"

	amove etc/init.d/systemd-udevd-postmount
}

udevd() {
	pkgdesc="systemd udev packaged alone"
	depends="$pkgname=$pkgver-r$pkgrel kmod-libs"
	# always provide a lower version than the real systemd-udevd but higher than
	# eudev
	# This shouldn't actually be a huge issue, since systemd-udevd is
	# explicitly installed on systemd images, but just in-case
	provides="
		udev=100.$pkgver-r$pkgrel
		eudev-libs=100.$pkgver-r$pkgrel
		so:libudev.so.1
		so:libudev.so
	"

	amove usr/bin/udevadm
	amove usr/lib/udev
	amove usr/lib/libudev*

	# Install symlinks to be more like eudev
	mkdir -p "$subpkgdir"/usr/sbin
	ln -sf ../bin/udevadm "$subpkgdir"/usr/sbin/udevd
}

