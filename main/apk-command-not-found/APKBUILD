maintainer="Aster Boese <asterboese@mailbox.org>"
pkgname=apk-command-not-found
pkgver=1
pkgrel=0
pkgdesc="Shell script to prompt to install a missing command"
url="https://postmarketos.org"
arch="noarch"
license="GPL-3.0-or-later"
depends="cmd:sh"
subpackages="
	$pkgname-bash
	$pkgname-fish
	$pkgname-zsh
"
source="apk-command-not-found.sh
	command-not-found.bash
	command-not-found.zsh
	command-not-found.fish
"
builddir="$srcdir"
options="!check"

package() {
	install -Dm755 "$srcdir"/apk-command-not-found.sh \
		"$pkgdir"/usr/bin/apk-command-not-found

	# /etc/bash/bashrc only sources .sh files for some reason
	install -Dm644 "$srcdir"/command-not-found.bash \
		"$pkgdir"/etc/bash/command-not-found.sh

	install -Dm644 "$srcdir"/command-not-found.fish \
		-t "$pkgdir"/usr/share/fish/vendor_functions.d/

	install -Dm644 "$srcdir"/command-not-found.zsh \
		-t "$pkgdir"/etc/zsh/zshrc.d/
}

bash() {
	pkgdesc="$pkgdesc (bash integration)"
	install_if="$pkgname=$pkgver-r$pkgrel bash"

	amove etc/bash
}

fish() {
	pkgdesc="$pkgdesc (fish integration)"
	install_if="$pkgname=$pkgver-r$pkgrel fish"

	amove usr/share
}

zsh() {
	pkgdesc="$pkgdesc (zsh integration)"
	install_if="$pkgname=$pkgver-r$pkgrel zsh"

	amove etc/zsh
}

