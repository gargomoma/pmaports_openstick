maintainer="Alicja Michalska <ellyqw@mainlining.org>"
pkgname=firmware-samsung-b2q
pkgver=2026.09
pkgrel=0
pkgdesc="Proprietary firmware blobs from stock firmware"
url="https://gitlab.postmarketos.org/ellyq/firmware-samsung-b2q"
arch="aarch64"
license="proprietary"
makedepends="zstd"

_commit="3e64f93abb5a2d4ad13a43a1e2394dfa79e89015"
source="https://gitlab.postmarketos.org/ellyq/firmware-samsung-b2q/-/archive/$_commit.tar.gz"
builddir="$srcdir/firmware-samsung-b2q-$_commit"
options="!check !archcheck !strip !tracedeps textrels pmb:cross-native"

build() {
	# Compress kernel-loaded DSP firmwares
	zstd sku12_eu/a660_zap.mbn
	zstd sku12_eu/adsp.mbn
	zstd sku12_eu/cdsp.mbn
	zstd sku12_eu/ipa_fws.mbn
	zstd sku12_eu/modem.mbn
	zstd sku12_eu/slpi.mbn
	zstd sku12_eu/vpu20_p4.mbn
}

package() {
	mkdir -p "$pkgdir"/usr/lib/firmware/qcom/sm8350/Samsung/b2q/
	install -Dm644 "$builddir"/sku12_eu/a660_zap.mbn.zst \
		       "$pkgdir"/usr/lib/firmware/qcom/sm8350/Samsung/b2q/a660_zap.mbn.zst
	install -Dm644 "$builddir"/sku12_eu/adsp.mbn.zst \
		       "$pkgdir"/usr/lib/firmware/qcom/sm8350/Samsung/b2q/adsp.mbn.zst
	install -Dm644 "$builddir"/sku12_eu/cdsp.mbn.zst \
		       "$pkgdir"/usr/lib/firmware/qcom/sm8350/Samsung/b2q/cdsp.mbn.zst
	install -Dm644 "$builddir"/sku12_eu/ipa_fws.mbn.zst \
		       "$pkgdir"/usr/lib/firmware/qcom/sm8350/Samsung/b2q/ipa_fws.mbn.zst
	install -Dm644 "$builddir"/sku12_eu/modem.mbn.zst \
		       "$pkgdir"/usr/lib/firmware/qcom/sm8350/Samsung/b2q/modem.mbn.zst
	install -Dm644 "$builddir"/sku12_eu/slpi.mbn.zst \
		       "$pkgdir"/usr/lib/firmware/qcom/sm8350/Samsung/b2q/slpi.mbn.zst
	install -Dm644 "$builddir"/sku12_eu/vpu20_p4.mbn.zst \
		       "$pkgdir"/usr/lib/firmware/qcom/sm8350/Samsung/b2q/vpu20_p4.mbn.zst
}

sha512sums="
