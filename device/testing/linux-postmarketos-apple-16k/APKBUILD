# NOTE: Please ensure any changes made to this kernel are also applied to the
#       4k variant.

# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm64/configs/defconfig
# Co-Maintainer: Aster Boese <asterboese@mailbox.org>
maintainer="Nick Chan <towinchenmi@gmail.com>"
pkgname=linux-postmarketos-apple-16k
pkgver=7.1
pkgrel=0
pkgdesc="Mainline kernel fork for Apple iPhone and iPad devices (16K)"
arch="aarch64"
url="https://kernel.org"
license="GPL-2.0-only"
makedepends="
	bison
	clang
	clang-libclang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	rust
	rust-bindgen
	rustfmt
	rust-src
	zstd
	"
source="
	https://github.com/HoolockLinux/linux/archive/refs/tags/hoolock-$pkgver-1.tar.gz
	config-${pkgname#linux-}.$arch
	0001-resolve_btfids-preserve-parameter-names-when-process.patch
	"
options="
	!check
	!strip
	!tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	pmb:kconfigcheck-rust
	"
builddir="$srcdir/linux-hoolock-$pkgver-1"

_carch="arm64"

# Used internally by pmbootstrap. Don't touch.
# TODO: Remove once minimum default pmbootstrap version supports
# kernel packages without '_flavor'.
_flavor="${pkgname#linux-}"

prepare() {
	default_prepare
	cp "$srcdir"/config-"${pkgname#linux-}"."$arch" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 HOSTLDFLAGS="-fuse-ld=lld" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	make dtbs_install modules_install zinstall \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_PATH="$pkgdir"/boot
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/"${pkgname#linux-}"/kernel.release
}

sha512sums="
