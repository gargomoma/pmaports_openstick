pkgname=sheng-keyboard-helper
pkgver=0.2.0
pkgrel=0
pkgdesc="Xiaomi Sheng keyboard helper daemon"
url="https://github.com/ianchb/xiaomi-sheng-keyboard-helper"
arch="aarch64"
license="Apache-2.0"
makedepends="glib-dev pkgconf sheng-sensors-dev"
_commit="3bb9aada8814e81a5c22de5d1e5dd70f4b99183e"
source="$pkgname-$_commit.tar.gz::https://github.com/ianchb/xiaomi-sheng-keyboard-helper/archive/$_commit.tar.gz"
builddir="$srcdir/xiaomi-sheng-keyboard-helper-$_commit"
options="!check"

build() {
	make
}

package() {
	make DESTDIR="$pkgdir" install

	install -d -m 0755 "$pkgdir/usr/share/doc/$pkgname"
	install -m 0644 README.md "$pkgdir/usr/share/doc/$pkgname/"
	install -m 0644 packaging/debian/copyright \
		"$pkgdir/usr/share/doc/$pkgname/"
}
