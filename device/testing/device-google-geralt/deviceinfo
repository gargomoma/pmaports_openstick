# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.

deviceinfo_format_version="0"
deviceinfo_name="Google Geralt Chromebook"
deviceinfo_manufacturer="Google"
deviceinfo_codename="google-geralt"
deviceinfo_year="2024"
deviceinfo_dtb="mediatek/mt8188-geralt*"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="laptop"
deviceinfo_external_storage="true"
deviceinfo_drm="true"
deviceinfo_disable_dhcpd="true"

# Bootloader related
deviceinfo_cgpt_kpart="/boot/vmlinuz.kpart"
deviceinfo_cgpt_kpart_start="8192"
# 128M kernel partition
deviceinfo_cgpt_kpart_size="262144"
# For some odd reason the chipsed its called mt8188g in depthcharge ¯\_(ツ)_/¯
deviceinfo_depthcharge_board="mt8188g"
deviceinfo_depthcharge_compression="lzma"
deviceinfo_generate_depthcharge_image="true"
