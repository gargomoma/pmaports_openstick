pkgname="sheng-devauth"
_commit=bac03b5bcfefa1467ebad490edd910a6cef8a207
pkgver=1.0
pkgdesc="Service used in pair with kernel driver to authenticate Xiaomi Keyboard"
pkgrel=1
arch="aarch64"
url="https://github.com/ianchb/sheng_devauth"
license="BSD-3-Clause"
makedepends="
	git
	make
	clang
	linux-headers
"
source="
	https://github.com/ianchb/sheng_devauth/archive/$_commit.zip
    	sheng-devauth.service
"

builddir="$srcdir/sheng_devauth-$_commit"

build() {
    cd "$builddir"

    make
}

package() {
    cd "$builddir"

    mkdir -p $pkgdir/usr/bin
    install -m 0755 xiaomi_devauth $pkgdir/usr/bin
    mkdir -p $pkgdir/usr/lib/systemd/system
    install -m 0644 $srcdir/sheng-devauth.service $pkgdir/usr/lib/systemd/system

    mkdir -p "$pkgdir/etc/systemd/system/sysinit.target.wants"
    ln -s /usr/lib/systemd/system/sheng-devauth.service \
    "$pkgdir/etc/systemd/system/sysinit.target.wants/sheng-devauth.service"
}
sha512sums="
