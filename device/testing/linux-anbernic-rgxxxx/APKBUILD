# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: https://github.com/ROCKNIX/distribution/blob/ca50938cbc2762d77203e1f63b8b8aa85a75f4a4/projects/ROCKNIX/devices/H700/linux/linux.aarch64.conf
maintainer="Kevin Widjaja <kevinwidjaja_dev@proton.me>"
pkgname=linux-anbernic-rgxxxx
pkgver=7.1.8
pkgrel=0
_commit="383c083c612f91a0510a525cc6f36a7063f00ce6"
pkgdesc="Close-to-mainline kernel fork for Anbernic RGXXXX H700 devices"
url="https://kernel.org"
arch="aarch64"
_carch="arm64"
license="GPL-2.0-only"
makedepends="
		bison
		clang
		elfutils-dev
		findutils
		flex
		linux-headers
		lld
		llvm
		openssl-dev
		pahole
		perl
		postmarketos-installkernel
		python3
		zstd
	"
options="
		!check
		!strip
		!tracedeps
		pmb:cross-native
		pmb:kconfigcheck-community
	"

_flavor="${pkgname#linux-}"

# Source
source="
	01-remove-rocknix-dt-id.patch
	02-v8_20260804_james_hilliard1_introduce_allwinner_h616_pwm_controller.patch
	03-rg35xx-enable-pwm-backlight.patch
	config-$_flavor.$arch
	minime-$_commit.tar.gz::https://github.com/minime-os/minime/archive/$_commit.tar.gz
	patch.files
	$pkgname-$pkgver.tar.gz::https://www.kernel.org/pub/linux/kernel/v${pkgver/.*/}.x/linux-${pkgver}.tar.gz
"
builddir="$srcdir"/linux-"$pkgver"

prepare() {
	# Apply select patches to the mainline kernel.
	local _i
	while IFS="" read -r _i || [ -n "$_i" ]; do
		patch -p1 < "$srcdir"/minime-"$_commit"/"$_i"
	done < "$srcdir"/patch.files

	makefile="$builddir"/arch/arm64/boot/dts/allwinner/Makefile

	for dts in "$srcdir"/minime-*/minime/boards/h700/dts/*dts*; do
		dtb="$(basename "$dts" | sed 's/\.dts$/.dtb/')"

		# Move the devicetree sources in the kernel tree.
		install -D -m644 "$dts" -t "$builddir"/arch/arm64/boot/dts/allwinner

		# Mention the devicetree blobs in the Makefile for
		# compilation if they're absent.
		if ! grep -q "$dtb" "$makefile"; then
			echo "dtb-\$(CONFIG_ARCH_SUNXI) += $dtb" >> "$makefile"
		fi
	done

	default_prepare
	cp "$srcdir"/config-$_flavor.$arch .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 HOSTLDFLAGS="-fuse-ld=lld" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	make dtbs_install modules_install zinstall \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_STRIP=1 \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

