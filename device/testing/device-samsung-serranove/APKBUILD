# Reference: <https://postmarketos.org/devicepkg>
maintainer="Jakko <jahau@rocketmail.com>"
pkgname=device-samsung-serranove
pkgdesc="Samsung Galaxy S4 Mini Value Edition"
pkgver=19
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	android-tools-mkbootimg
	firmware-qcom-adreno-a300
	firmware-samsung-serranove
	linux-postmarketos-qcom-msm8916
	msm-firmware-loader
	postmarketos-base
	soc-qcom-msm8916
	soc-qcom-msm8916-rproc
	soc-samsung-msm8916-modem-workaround
	"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	phoc.ini
	"
subpackages="$pkgname-phosh"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/phoc.ini \
		"$pkgdir"/usr/share/phosh/phoc.ini
}

phosh() {
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-phosh"
	replaces="phosh"

	amove usr/share/phosh
}

