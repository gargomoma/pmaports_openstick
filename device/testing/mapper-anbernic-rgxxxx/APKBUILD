# Reference: <https://postmarketos.org/devicepkg>
maintainer="Kevin Widjaja <kevinwidjaja_dev@proton.me>"
pkgname=mapper-anbernic-rgxxxx
pkgdesc="Anbernic H700 D-pad to mouse mapper"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="py3-evdev"
install="$pkgname-openrc.post-install"
subpackages="
	$pkgname-systemd
	$pkgname-openrc
"
source="
	mapper-anbernic-rgxxxx.init
	mapper-anbernic-rgxxxx.service
	rgxxxx-control-mapper.py
"

package() {
	install -Dm755 "$srcdir"/rgxxxx-control-mapper.py \
		"$pkgdir"/usr/bin/rgxxxx-control-mapper
	install -Dm755 "$srcdir"/$pkgname.init \
		"$pkgdir"/etc/init.d/rgxxxx-control-mapper
	install -Dm644 "$srcdir"/$pkgname.service -t \
		"$pkgdir"/usr/lib/systemd/system
}

