new file mode 100644
index 0000000..ec2671d
--- /dev/null
+++ b/drivers/video/fbdev/amba-clcd.c
@@ -0,0 +1,1093 @@
+/*
+ *  linux/drivers/video/amba-clcd.c
+ *
