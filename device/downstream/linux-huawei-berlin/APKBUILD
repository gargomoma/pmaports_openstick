makedepends="
	bash
	bc
	bison
	devicepkg-dev
	dtc
	findutils
	flex
	kmod
	openssl-dev
	perl
	xz
"

# Source
_repository="labyrinth_kernel_prague"
_commit="f148d781c3d6bad4bae8d1c4073e233abeca9c96"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/Dil3mm4/$_repository/archive/$_commit.tar.gz
	$_config
	01_remove_wireguard.patch
	02_fix_undeclared_AID_INET.patch
	03_fix_dtc.patch
	04_make_rdr_hisi_adapter_compileable.patch
	05-disable-huawei-bfmr.patch
	06-change-bfgx-and-wifi-cfg-paths.patch
	07-fix-p2p.patch
	linux4.2-gcc10-extern_YYLOC_global_declaration.patch
"
builddir="$srcdir/$_repository-$_commit"
_outdir="out"

_verify_rc6_config() {
	local symbol
	for symbol in CGROUP_PIDS CGROUP_DEVICE PAGE_COUNTER MEMCG MEMCG_SWAP \
		MEMCG_SWAP_ENABLED CGROUP_WRITEBACK CFS_BANDWIDTH CGROUP_SCHEDTUNE \
		NAMESPACES UTS_NS IPC_NS USER_NS PID_NS NET_NS SECCOMP SECCOMP_FILTER \
		OVERLAY_FS VETH BRIDGE BRIDGE_NETFILTER NETFILTER_XT_MATCH_ADDRTYPE \
		NF_TABLES NF_TABLES_IPV4 NFT_META NFT_CT NFT_NAT NFT_MASQ \
		NFT_CHAIN_NAT_IPV4 NFT_MASQ_IPV4 NF_NAT_IPV4 NF_NAT_MASQUERADE_IPV4; do
		grep -qx "CONFIG_$symbol=y" "$_outdir/.config" || return 1
	done
	grep -qx '# CONFIG_HW_CGROUP_PIDS is not set' "$_outdir/.config"
	for symbol in IP_NF_NAT IP_NF_TARGET_MASQUERADE IP_NF_TARGET_NETMAP \
		IP_NF_TARGET_REDIRECT IP6_NF_NAT IP6_NF_TARGET_MASQUERADE \
		NETFILTER_XT_NAT NETFILTER_XT_TARGET_NETMAP NETFILTER_XT_TARGET_REDIRECT; do
		grep -qx "CONFIG_$symbol=m" "$_outdir/.config" || return 1
	done
	printf '%s\n' 'RC6_EFFECTIVE_CONFIG_ASSERTIONS_PASS (runtime compatibility not tested)'
}

prepare() {
	default_prepare
	. downstreamkernel_prepare
	_verify_rc6_config
}

build() {
	unset LDFLAGS
	_verify_rc6_config
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	_verify_rc6_config
	local kernel_release module_dir resolved_pkgdir
	kernel_release="$(cat "$_outdir"/include/config/kernel.release)"
	case "$kernel_release" in
		""|*[!a-zA-Z0-9._+-]*|.|..) return 1 ;;
	esac
	test -n "$pkgdir" && test "$pkgdir" != /
	case "$pkgdir" in /*) ;; *) return 1 ;; esac
	mkdir -p "$pkgdir"
	test -d "$pkgdir" && test ! -L "$pkgdir"
	resolved_pkgdir="$(realpath "$pkgdir")"
	test "$resolved_pkgdir" = "$pkgdir"
	module_dir="$pkgdir/usr/lib/modules/$kernel_release"
	export KERNEL_IMAGE_NAME="Image.gz"
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"
	cmp "$_outdir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
	cmp "$_outdir/arch/$_carch/boot/$KERNEL_IMAGE_NAME" "$pkgdir/boot/vmlinuz"

	# The downstream helper installs vmlinuz only. Keep the optional legacy
	# NAT modules with this exact kernel; they must not be built in on 4.4.
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS" \
		INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1 \
		DEPMOD=depmod modules_install
	# Do not publish symlinks back to the private source/build directory.
	rm -f "$module_dir"/build "$module_dir"/source
	test -s "$module_dir"/modules.dep
	test -f "$module_dir"/kernel/net/ipv4/netfilter/iptable_nat.ko
	test -f "$module_dir"/kernel/net/ipv4/netfilter/ipt_MASQUERADE.ko
	test -f "$module_dir"/kernel/net/ipv6/netfilter/ip6table_nat.ko
	test -f "$module_dir"/kernel/net/ipv6/netfilter/ip6t_MASQUERADE.ko
	test -f "$module_dir"/kernel/net/netfilter/xt_nat.ko
	test -f "$module_dir"/kernel/net/netfilter/xt_NETMAP.ko
	test -f "$module_dir"/kernel/net/netfilter/xt_REDIRECT.ko
	cmp "$_outdir/modules.order" "$module_dir/modules.order"
	cmp "$_outdir/modules.builtin" "$module_dir/modules.builtin"
	local module
	while IFS= read -r module; do
		case "$module" in
			kernel/*.ko) ;;
			*) return 1 ;;
		esac
		case "/$module/" in */../*|*/./*) return 1 ;; esac
		test -s "$module_dir/$module" || return 1
	done < "$_outdir/modules.order"
	printf '%s\n' 'RC6_MODULES_INSTALL_INVENTORY_PASS (offline only)'
}

