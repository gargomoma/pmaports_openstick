# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm64/configs/vendor/lineage-gts7fewifi_defconfig, with the
# 'pmbootstrap kconfig check' options enabled and SELinux off.

maintainer="dh <kood7567@gmail.com>"
pkgname=linux-samsung-gts7fewifi
pkgver=5.4.254
pkgrel=0
pkgdesc="Samsung Galaxy Tab S7 FE Wi-Fi kernel fork"
arch="aarch64"
_carch="arm64"
_flavor="samsung-gts7fewifi"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	cpio
	devicepkg-dev
	findutils
	flex
	gcc6
	openssl-dev
	perl
	tar
	xz
"

_setup_compiler() {
	if [ "${CC:0:5}" != "gcc6-" ]; then
		export CC="gcc6-${CC:-gcc}"
		export HOSTCC="gcc6-gcc"
	fi
}

# Same tree as the archived device-samsung-a52sxq port (android_kernel_samsung_sm7325), on
# the branch with gts7fewifi board support; the fix-*/drop-* patches repair its merge artifacts.
_repository="android_kernel_samsung_sm7325"
_commit="d23fb02643beda440235a3281637a6ffc03f48d7"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/Bush-cat/$_repository/archive/$_commit.tar.gz
	$_config
	fix-camera-include-paths.patch
	fix-duplicate-mmap-readaround-limit.patch
	drop-chipidea-mtp-quirk.patch
	drop-ion-tracing-marks.patch
	sde-advertise-in-formats.patch
	sde-dedupe-plane-formats.patch
	audio-disable-wcn-bt-dai-links.patch
	audio-afe-hw-params-buffer-overrun.patch
	audio-skip-pdr-no-modem.patch
	audio-log-pcm-capture-failures.patch
	audio-cs35l45-quiet-mute-log.patch
	bt-sock-null-sk.patch
	dsi-drm-mode-clock-matches-timings.patch
	bt-wcn6750-support.patch
	bt-wcn6750-serdev-dt.patch
	hci_sock-v5.4-upstream.c
	statx-mnt-id-backport.patch
	zstd-prepare-preboot.patch
	zstd-add-decompress.patch
	zstd-rd-zstd-kconfig.patch
	zstd-limit-output-size.patch
	v4l2loopback.c
	v4l2loopback.h
	v4l2loopback_formats.h
"
builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare
	_setup_compiler

	# Bypass scripts/gcc-wrapper.py, which breaks Kconfig's compiler probe.
	export DISABLE_WRAPPER=1

	REPLACE_GCCH=0 . downstreamkernel_prepare

	# Samsung stubbed out hci_sock_create(); restore upstream v5.4 hci_sock.c wholesale
	# (the removed blocks reference each other).
	cp "$srcdir"/hci_sock-v5.4-upstream.c "$builddir"/net/bluetooth/hci_sock.c

	# Integrate v4l2loopback directly into the media subsystem
	cp "$srcdir"/v4l2loopback.c "$srcdir"/v4l2loopback.h "$srcdir"/v4l2loopback_formats.h "$builddir"/drivers/media/v4l2-core/
	printf '\nconfig VIDEO_V4L2_LOOPBACK\n\ttristate "V4L2 loopback video device"\n\tdepends on VIDEO_DEV && VIDEO_V4L2\n\tdefault m\n' >> "$builddir"/drivers/media/v4l2-core/Kconfig
	printf '\nobj-$(CONFIG_VIDEO_V4L2_LOOPBACK) += v4l2loopback.o\n' >> "$builddir"/drivers/media/v4l2-core/Makefile
}

build() {
	_setup_compiler
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		DISABLE_WRAPPER=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	_setup_compiler
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"

	# downstreamkernel_package does not install modules; without this no .ko ships (no
	# touchscreen, no Wi-Fi). unset LDFLAGS: abuild's hardening flags break the module linker.
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		DISABLE_WRAPPER=1 \
		INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1 modules_install

	# Fail the build rather than ship a kernel with no drivers.
	_nko=$(find "$pkgdir"/usr/lib/modules -name '*.ko' 2>/dev/null | wc -l)
	[ "$_nko" -gt 0 ] || die "modules_install produced no .ko files: touchscreen and WiFi would both be dead"
	msg "installed $_nko kernel modules"

	# Base SM7325 (yupik) DTB; board overlays stay in the stock dtbo partition.
	mkdir -p "$pkgdir"/usr/share/dtb
	cp "$_outdir"/arch/arm64/boot/dts/vendor/qcom/yupik.dtb \
		"$pkgdir"/usr/share/dtb/gts7fewifi.dtb
}

