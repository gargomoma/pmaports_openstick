build() {
	devicepkg_build $startdir $pkgname
}

check() {
	sh -n "$srcdir"/kill-pbsplash.initd
	sh -n "$srcdir"/honor6x-p31-splash-stop
	sh -n "$srcdir"/honor6x-lightdm.confd
	H6X_DEVICE_SOURCE="$startdir" python3 -B "$srcdir"/test_device_integration.py
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/90-honor6x-rndis.conf \
		"$pkgdir"/usr/lib/NetworkManager/conf.d/90-honor6x-rndis.conf
	install -Dm644 "$srcdir"/90-honor6x-wifi.conf \
		"$pkgdir"/usr/lib/NetworkManager/conf.d/90-honor6x-wifi.conf
	install -Dm755 "$srcdir"/honor6x-screen-toggle.py \
		"$pkgdir"/usr/sbin/honor6x-screen-toggle
	install -Dm755 "$srcdir"/honor6x-health-led \
		"$pkgdir"/usr/sbin/honor6x-health-led
	install -Dm755 "$srcdir"/honor6x-zramstart \
		"$pkgdir"/usr/sbin/honor6x-zramstart
	install -Dm755 "$srcdir"/honor6x-wifi-control \
		"$pkgdir"/usr/libexec/honor6x/honor6x-wifi-control
	install -Dm755 "$srcdir"/honor6x-wifi-psk.py \
		"$pkgdir"/usr/libexec/honor6x/honor6x-wifi-psk
	install -Dm644 "$srcdir"/honor6x-network-interfaces \
		"$pkgdir"/etc/network/interfaces
	install -Dm755 "$srcdir"/honor6x-p31-splash-stop \
		"$pkgdir"/usr/libexec/honor6x-p31-splash-stop
	install -Dm755 -t "$pkgdir"/etc/init.d/ \
		"$srcdir"/honor6x-screen-toggle.initd \
		"$srcdir"/honor6x-health-led.initd \
		"$srcdir"/honor6x-zram-swap.initd \
		"$srcdir"/honor6x-wifi.initd \
		"$srcdir"/kill-pbsplash.initd
	mv "$pkgdir"/etc/init.d/honor6x-screen-toggle.initd \
		"$pkgdir"/etc/init.d/honor6x-screen-toggle
	mv "$pkgdir"/etc/init.d/honor6x-health-led.initd \
		"$pkgdir"/etc/init.d/honor6x-health-led
	mv "$pkgdir"/etc/init.d/honor6x-zram-swap.initd \
		"$pkgdir"/etc/init.d/honor6x-zram-swap
	mv "$pkgdir"/etc/init.d/honor6x-wifi.initd \
		"$pkgdir"/etc/init.d/honor6x-wifi
	mv "$pkgdir"/etc/init.d/kill-pbsplash.initd \
		"$pkgdir"/etc/init.d/kill-pbsplash
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="openrc"

	amove etc/init.d/honor6x-screen-toggle
	amove etc/init.d/honor6x-health-led
	amove etc/init.d/honor6x-zram-swap
	amove etc/init.d/honor6x-wifi
	amove etc/init.d/kill-pbsplash
}

xfce() {
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-xfce4"
	depends="faenza-icon-theme font-noto-cjk gtk+3.0 honor6x-faccessat-compat honor6x-fbdevhw-compat lightdm polkit postmarketos-ui-xfce4 py3-gobject3 xf86-input-libinput xf86-video-fbdev xset"

	install -Dm644 "$srcdir"/honor6x-fbdev.conf.in \
		"$subpkgdir"/usr/share/honor6x/honor6x-fbdev.conf.in
	install -Dm644 "$srcdir"/honor6x-xorg-policy.conf \
		"$subpkgdir"/usr/share/X11/xorg.conf.d/22-honor6x-xorg-policy.conf
	install -Dm644 "$srcdir"/50-honor6x-lightdm.conf \
		"$subpkgdir"/etc/lightdm/lightdm.conf.d/50-honor6x.conf
	install -Dm644 "$srcdir"/49-honor6x-power.rules \
		"$subpkgdir"/usr/share/polkit-1/rules.d/49-honor6x-power.rules
	install -Dm644 "$srcdir"/49-honor6x-wifi.rules \
		"$subpkgdir"/usr/share/polkit-1/rules.d/49-honor6x-wifi.rules
	install -Dm755 "$srcdir"/honor6x-display-setup \
		"$subpkgdir"/usr/sbin/honor6x-display-setup
	install -Dm755 "$srcdir"/honor6x-display-orientation \
		"$subpkgdir"/usr/sbin/honor6x-display-orientation
	install -Dm755 "$srcdir"/honor6x-display-manager \
		"$subpkgdir"/usr/sbin/honor6x-display-manager
	install -Dm755 "$srcdir"/honor6x-displayctl \
		"$subpkgdir"/usr/bin/honor6x-displayctl
	install -Dm755 "$srcdir"/honor6x-brightness-control \
		"$subpkgdir"/usr/libexec/honor6x/honor6x-brightness-control
	install -Dm755 "$srcdir"/honor6x-brightness.py \
		"$subpkgdir"/usr/bin/honor6x-brightness
	install -Dm644 "$srcdir"/honor6x-brightness.desktop \
		"$subpkgdir"/usr/share/applications/honor6x-brightness.desktop
	install -Dm755 "$srcdir"/honor6x-xfce-session \
		"$subpkgdir"/usr/bin/honor6x-xfce-session
	install -Dm644 "$srcdir"/honor6x-xfce.desktop \
		"$subpkgdir"/usr/share/xsessions/honor6x-xfce.desktop
	install -Dm755 "$srcdir"/honor6x-wifi-tray.py \
		"$subpkgdir"/usr/bin/honor6x-wifi-tray
	install -Dm644 "$srcdir"/honor6x-wifi.desktop \
		"$subpkgdir"/usr/share/applications/honor6x-wifi.desktop
	install -Dm644 "$srcdir"/honor6x-wifi-tray.desktop \
		"$subpkgdir"/etc/xdg/autostart/honor6x-wifi-tray.desktop
	install -Dm755 "$srcdir"/honor6x-wallpaper \
		"$subpkgdir"/usr/bin/honor6x-wallpaper
	install -Dm644 "$srcdir"/honor6x-wallpaper.desktop \
		"$subpkgdir"/etc/xdg/autostart/honor6x-wallpaper.desktop
	install -Dm644 "$srcdir"/honor6x-landscape.desktop \
		"$subpkgdir"/usr/share/applications/honor6x-landscape.desktop
	install -Dm644 "$srcdir"/honor6x-portrait.desktop \
		"$subpkgdir"/usr/share/applications/honor6x-portrait.desktop
	install -Dm644 "$srcdir"/honor6x-appfinder.desktop \
		"$subpkgdir"/etc/xdg/xfce4-phone-honor6x/xfce4/panel/launcher-15/honor6x-appfinder.desktop
	install -Dm644 "$srcdir"/honor6x-terminal.desktop \
		"$subpkgdir"/etc/xdg/xfce4-phone-honor6x/xfce4/panel/launcher-12/honor6x-terminal.desktop
	install -Dm644 "$srcdir"/honor6x-files.desktop \
		"$subpkgdir"/etc/xdg/xfce4-phone-honor6x/xfce4/panel/launcher-13/honor6x-files.desktop
	install -Dm644 "$srcdir"/honor6x-settings.desktop \
		"$subpkgdir"/etc/xdg/xfce4-phone-honor6x/xfce4/panel/launcher-14/honor6x-settings.desktop
	install -Dm644 "$srcdir"/v26-honor6x-desktop.xml \
		"$subpkgdir"/etc/xdg/xfce4-phone-honor6x/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml
	install -Dm644 "$srcdir"/v26-honor6x-panel.xml \
		"$subpkgdir"/etc/xdg/xfce4-phone-honor6x/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml
	install -Dm644 "$srcdir"/v26-honor6x-xsettings.xml \
		"$subpkgdir"/etc/xdg/xfce4-phone-honor6x/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml
	install -Dm644 "$srcdir"/v26-honor6x-xfwm4.xml \
		"$subpkgdir"/etc/xdg/xfce4-phone-honor6x/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml
	install -Dm644 "$srcdir"/v26-honor6x-appfinder.xml \
		"$subpkgdir"/etc/xdg/xfce4-phone-honor6x/xfce4/xfconf/xfce-perchannel-xml/xfce4-appfinder.xml
	install -Dm644 "$srcdir"/v26-honor6x-power-manager.xml \
		"$subpkgdir"/etc/xdg/xfce4-phone-honor6x/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml
	install -Dm644 "$srcdir"/v26-honor6x-screensaver.xml \
		"$subpkgdir"/etc/xdg/xfce4-phone-honor6x/xfce4/xfconf/xfce-perchannel-xml/xfce4-screensaver.xml
	install -Dm644 "$srcdir"/nm-applet.desktop \
		"$subpkgdir"/etc/xdg/xfce4-phone-honor6x/autostart/nm-applet.desktop
	install -Dm644 "$srcdir"/blueman.desktop \
		"$subpkgdir"/etc/xdg/xfce4-phone-honor6x/autostart/blueman.desktop
	install -d "$subpkgdir"/etc/skel "$subpkgdir"/usr/share/pixmaps/faces
	ln -s ../../usr/share/icons/Faenza/stock/96/avatar-default.png \
		"$subpkgdir"/etc/skel/.face
	ln -s ../../icons/Faenza/stock/96/avatar-default.png \
		"$subpkgdir"/usr/share/pixmaps/faces/default.png
	install -Dm644 "$srcdir"/90_honor6x-slick-greeter.gschema.override \
		"$subpkgdir"/usr/share/glib-2.0/schemas/90_honor6x-slick-greeter.gschema.override
	install -Dm644 "$srcdir"/honor6x-pmos-v26-landscape.png \
		"$subpkgdir"/usr/share/backgrounds/honor6x/honor6x-pmos-v26-landscape.png
	install -Dm644 "$srcdir"/honor6x-pmos-v26-portrait.png \
		"$subpkgdir"/usr/share/backgrounds/honor6x/honor6x-pmos-v26-portrait.png
}

xfce_openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-xfce4 openrc"
	depends="$pkgname-xfce=$pkgver-r$pkgrel openrc"

	install -Dm755 "$srcdir"/honor6x-display-manager.initd \
		"$subpkgdir"/etc/init.d/honor6x-display-manager
	install -Dm644 "$srcdir"/honor6x-lightdm.confd \
		"$subpkgdir"/etc/conf.d/lightdm
}

