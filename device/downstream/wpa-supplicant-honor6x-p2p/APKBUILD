maintainer="YuanLang <tsushdkjfajxnxm@gmail.com>"
pkgname=wpa-supplicant-honor6x-p2p
pkgver=2.11
pkgrel=3
pkgdesc="Disabled-by-default isolated wpa_supplicant for Honor 6X P2P-GO"
url="https://w1.fi/wpa_supplicant/"
arch="aarch64"
license="BSD-3-Clause"
# The crossdirect buildroot lacks the GCC LTO linker plugin for this package.
# Keep this isolated probe on the qemu-only build path instead.
options="!check !pmb:crossdirect"
makedepends="linux-headers openssl-dev>3 dbus-dev libnl3-dev pcsc-lite-dev"
source="https://w1.fi/releases/wpa_supplicant-$pkgver.tar.gz
	0001-nl80211-extra-ies.patch
	0002-ap-ft-sae-guard.patch
	0003-authorization-revert.patch
	0004-existing-p2p-management-interface.patch
	0005-nl80211-preserve-external-p2p-device.patch
	0006-nl80211-skip-external-p2p-lifecycle.patch
	config
	README.md
	"
builddir="$srcdir/wpa_supplicant-$pkgver"

prepare() {
	default_prepare
	cp "$srcdir/config" "$builddir/wpa_supplicant/.config"
}

build() {
	make -C wpa_supplicant LIBDIR=/lib BINDIR=/sbin wpa_supplicant
}

package() {
	install -Dm755 wpa_supplicant/wpa_supplicant \
		"$pkgdir/usr/libexec/honor6x/wpa_supplicant-p2p"
	install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}

