maintainer="YuanLang <tsushdkjfajxnxm@gmail.com>"
pkgname=honor6x-hotspot
pkgdesc="Honor 6X P2P-GO hotspot controller"
pkgver=2
pkgrel=2
url="https://gitlab.postmarketos.org/"
arch="aarch64"
license="MIT"
checkdepends="python3"
depends="
curl
dnsmasq
iw
iptables-legacy
iproute2
openrc
util-linux-misc
wpa_supplicant
wpa-supplicant-honor6x-p2p
"
source="
honor6x-hotspot-control
honor6x-hotspot-worker
test_hotspot_control.py
test_hotspot_nat.py
50-honor6x-hotspot.rules
README.md
"

check() {
	sh -n "$srcdir"/honor6x-hotspot-control
	sh -n "$srcdir"/honor6x-hotspot-worker
	python3 "$srcdir"/test_hotspot_control.py
	python3 "$srcdir"/test_hotspot_nat.py
}

package() {
	install -Dm755 "$srcdir"/honor6x-hotspot-control \
		"$pkgdir"/usr/libexec/honor6x/honor6x-hotspot-control
	install -Dm755 "$srcdir"/honor6x-hotspot-worker \
		"$pkgdir"/usr/libexec/honor6x/honor6x-hotspot-worker
	install -Dm644 "$srcdir"/50-honor6x-hotspot.rules \
		"$pkgdir"/usr/share/polkit-1/rules.d/50-honor6x-hotspot.rules
	install -Dm644 "$srcdir"/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

