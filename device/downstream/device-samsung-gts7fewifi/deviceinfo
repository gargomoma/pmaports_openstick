# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.
# Samsung Galaxy Tab S7 FE Wi-Fi (SM-T733 / SM-T730), SM7325 "yupik". The LTE/5G variants
# (SM-T736B / SM-T735, gts7xllite) are SM7225 and not covered by this port.

deviceinfo_format_version="0"
deviceinfo_name="Samsung Galaxy Tab S7 FE Wi-Fi"
deviceinfo_manufacturer="Samsung"
deviceinfo_codename="samsung-gts7fewifi"
deviceinfo_year="2021"
deviceinfo_dtb="gts7fewifi"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="tablet"
deviceinfo_external_storage="true"

# Bootloader related
# header_version and flash_pagesize match the stock boot.img and vendor_boot.img.
deviceinfo_generate_bootimg="true"
deviceinfo_flash_pagesize="4096"
deviceinfo_header_version="3"

# Load addresses from the stock vendor_boot.img (header version 3 keeps them there).
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x02000000"
deviceinfo_flash_offset_tags="0x01e00000"
deviceinfo_flash_offset_dtb="0x01f00000"

# No flash method: Samsung download mode, flash boot.img and vendor_boot.img together by hand
# with odin4 (heimdall fails on large writes). The names below serve 'flasher flash_vbmeta'.
deviceinfo_flash_heimdall_partition_vbmeta="VBMETA"
deviceinfo_flash_heimdall_partition_vendor_boot="VENDOR_BOOT"

# msdos, not gpt: the rootfs lives inside the userdata partition and the initramfs probes
# that nested table with busybox fdisk, which cannot read GPT.
deviceinfo_partition_type="msdos"

# No rootfs_image_sector_size=4096: the initramfs probes the nested table with 512-byte
# sectors and would never find the rootfs.
