#!/sbin/openrc-run
description="Samsung Galaxy Tab S7 FE hardware bringup"

depend() {
	after modules
	before wlan
	keyword -timeout
}

start() {
	ebegin "Starting Samsung Galaxy Tab S7 FE hardware bringup"
	for s in /usr/libexec/gts7fewifi/*.start; do
		if [ -x "$s" ]; then
			"$s"
		fi
	done
	eend 0
}
