#!/bin/sh
# Toggle the screen by dimming the backlight only. FBIOBLANK, DPMS off and bl_power kill
# this panel until reboot; writing brightness is safe.
set -u

B=/sys/class/backlight/panel0-backlight
S=/run/screen-toggle.level

[ -w "$B/brightness" ] || exit 1

read -r cur < "$B/brightness" 2>/dev/null || cur=0
if [ "${cur:-0}" -gt 0 ]; then
	echo "$cur" > "$S" 2>/dev/null
	chmod 666 "$S" 2>/dev/null || true
	echo 0 > "$B/brightness"
else
	read -r prev < "$S" 2>/dev/null || prev=""
	if [ -z "$prev" ] || [ "$prev" -eq 0 ] 2>/dev/null; then
		read -r max_b < "$B/max_brightness" 2>/dev/null || max_b=255
		prev=$(( max_b / 2 ))
	fi
	echo "$prev" > "$B/brightness"
fi
exit 0
