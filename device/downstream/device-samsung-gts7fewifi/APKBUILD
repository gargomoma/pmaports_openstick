# Reference: <https://postmarketos.org/devicepkg>
maintainer="dh <kood7567@gmail.com>"
pkgname=device-samsung-gts7fewifi
pkgdesc="Samsung Galaxy Tab S7 FE Wi-Fi"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-samsung-gts7fewifi
	mesa-vulkan-freedreno
	postmarketos-base
	postmarketos-base-downstream
"
# mesa-vulkan-freedreno: Turnip on KGSL is the GPU driver for the Adreno 642L and nothing
# else pulls it in; without it the desktop runs on llvmpipe.
makedepends="devicepkg-dev linux-headers"
# No source tarball: build the shims in $srcdir.
builddir="$srcdir"
install="
	$pkgname.post-install
	$pkgname.post-upgrade
	$pkgname-openrc.post-install
	$pkgname-openrc.post-upgrade
	$pkgname-phosh.post-install
	$pkgname-phosh-openrc.post-install
	"
# $pkgname-openrc last: abuild's default openrc() takes every etc/init.d and etc/conf.d
# file still in $pkgdir, after the subpackage-specific OpenRC splits took theirs.
subpackages="
	$pkgname-xorg
	$pkgname-xorg-openrc:xorg_openrc
	$pkgname-wayland
	$pkgname-phosh
	$pkgname-phosh-openrc:phosh_openrc
	$pkgname-openrc
	"
source="
	deviceinfo
	kernel-cmdline.conf
	99-block-broken-vidc.rules
	99-block-afe-pcm.rules
	wireplumber-50-gts7fewifi-alsa.conf
	60-kgsl.rules
	61-backlight.rules
	screen-toggle
	local-10-usbnet.start
	local-15-vendor-firmware.start
	local-16-vidc-unblock.start
	local-18-subsystem-restart.start
	local-20-usbnet-route.start
	local-30-wifi.start
	local-40-noblank.start
	local-45-greetd-runtime.start
	local-50-spen.start
	local-60-governor.start
	local-72-audio-bringup.start
	gts7fewifi-bringup.initd
	conf.d-udev-settle
	nm-dispatcher-50-chrony
	audio-up
	periodic-weekly-fstrim
	noblank.c
	faccessat-compat.c
	conf.d-lightdm
	lightdm.conf
	lightdm-gtk-greeter.conf
	xdg-autostart-noblank.desktop
	xorg-10-noblank.conf
	xorg-20-fbdev.conf
	weston.ini
	xfce4-panel.xml
	labwc-autostart
	labwc-menu.xml
	labwc-rc.xml
	pam.d-phosh
	phosh-greetd-config.toml
	conf.d-greetd
	wayland-sessions-phosh.desktop
	phosh-session-gts7fewifi
	phrog-greeter-gts7fewifi
	check-apk-perms
	logind-40-gts7fewifi.conf
	dconf-profile-user
	dconf-00-noblank
	dconf-10-no-lock
	powerbutton-daemon
	powerbutton.initd
	62-powerbutton-libinput.rules
	qpnp-volume-relay.c
	qpnp-volume-relay.initd
	polkit-50-user.rules
	sysctl-50-polkit-pidfd.conf
	dconf-20-osk.conf
	dconf-30-power.conf
	ucm2/samsung-gts7fewifi.conf
	ucm2/HiFi.conf
	dconf-locks-lock
	dconf-locks-osk
	dconf-locks-power
	dconf-40-scale-to-fit
	dconf-50-window-buttons
	android-camera.initd
	62-video.rules
	v4l2loopback-modules.conf
	v4l2loopback-modprobe.conf
	ld.config.txt
	sysctl-99-security.conf
	sshd-50-security.conf
	modprobe-50-security-blacklist.conf
	limits-10-disable-coredump.conf
	battery-protect
	battery-protect.initd
	battery-protect.conf
	sysctl-98-memory-tuning.conf
	dconf-35-wifi-only.conf
	dconf-locks-wifi-only
	dconf-45-app-folders.conf
	gtk3-hide-cellular.css
	65-sec-epen.hwdb
	fonts-local.conf
	osk-toggle
	osk-toggle.desktop
	bridge.c
	props.c
	selinux_shim.c
	pmos-props.conf
	vintf-manifest.xml
	vintf-framework-manifest.xml
	camxoverridesettings.txt
	camera-stack.sh
	camera-bridge
	camera-bridge.initd
	logdw-sink.initd
	camera-bridge.confd
	logdw-sink.py
	logdw-listen.py
	phoc.ini
"

build() {
	devicepkg_build $startdir $pkgname

	# musl declares ioctl(int, int, ...); the glibc signature does not compile.
	${CC:-gcc} -shared -fPIC -O2 -o noblank.so "$srcdir"/noblank.c -ldl
	${CC:-gcc} -shared -fPIC -O2 -o faccessat-compat.so "$srcdir"/faccessat-compat.c -ldl
	${CC:-gcc} -O2 -Wall -o qpnp-volume-relay "$srcdir"/qpnp-volume-relay.c

	# Camera preload libraries run inside bionic processes: -nostdlib keeps musl out and
	# every libc symbol binds to bionic at load time.
	_camlib() {
		${CC:-gcc} -shared -fPIC -nostdlib -fno-builtin \
			-fno-stack-protector -Wl,-soname,"$1" \
			-o "$srcdir/$1" "$srcdir/$2"
	}
	_camlib libselinux_shim.so selinux_shim.c
	_camlib libpmos_props.so props.c
	_camlib libbridge.so bridge.c
}

package() {
	devicepkg_package $startdir $pkgname

	# Deny the msm_vidc nodes until 16-vidc-unblock.start has verified the vpu20_1v
	# firmware; opening them without it wedges the caller in D state.
	install -Dm644 "$srcdir"/99-block-broken-vidc.rules \
		"$pkgdir"/usr/lib/udev/rules.d/99-block-broken-vidc.rules
	install -Dm644 "$srcdir"/60-kgsl.rules \
		"$pkgdir"/usr/lib/udev/rules.d/60-kgsl.rules

	# Deny the AFE-PROXY PCM nodes: probing them panics an unpatched kernel.
	# 72-audio-bringup.start relaxes this once the patched platform_dlkm is loaded.
	install -Dm644 "$srcdir"/99-block-afe-pcm.rules \
		"$pkgdir"/usr/lib/udev/rules.d/99-block-afe-pcm.rules

	# ACP off for this card, UCM instead: ACP probes all forty DSP PCMs and wedges on MultiMedia2.
	install -Dm644 "$srcdir"/wireplumber-50-gts7fewifi-alsa.conf \
		"$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/50-gts7fewifi-alsa.conf

	# FBIOBLANK kills the panel until reboot; screen-toggle dims the backlight instead.
	# The rule grants write on brightness only, never on bl_power.
	install -Dm644 "$srcdir"/61-backlight.rules \
		"$pkgdir"/usr/lib/udev/rules.d/61-backlight.rules
	install -Dm755 "$srcdir"/screen-toggle "$pkgdir"/usr/bin/screen-toggle

	# Boot bringup scripts, run in glob order by the gts7fewifi-bringup service.
	for f in 10-usbnet 15-vendor-firmware 16-vidc-unblock 18-subsystem-restart 20-usbnet-route 30-wifi \
			40-noblank 45-greetd-runtime 50-spen 60-governor 72-audio-bringup; do
		install -Dm755 "$srcdir"/local-$f.start "$pkgdir"/usr/libexec/gts7fewifi/$f.start
	done
	install -Dm755 "$srcdir"/gts7fewifi-bringup.initd \
		"$pkgdir"/etc/init.d/gts7fewifi-bringup

	# udev-settle never completes here: cap its timeout (replaces the udev-init-scripts-openrc file).
	install -Dm644 "$srcdir"/conf.d-udev-settle "$pkgdir"/etc/conf.d/udev-settle

	# Weekly fstrim of the UFS; not 'fstrim -a', see the script.
	install -Dm755 "$srcdir"/periodic-weekly-fstrim \
		"$pkgdir"/etc/periodic/weekly/fstrim

	# No readable RTC: every boot starts in 1970, so kick chrony as soon as a link is up.
	install -Dm755 "$srcdir"/nm-dispatcher-50-chrony \
		"$pkgdir"/usr/lib/NetworkManager/dispatcher.d/50-chrony

	# faccessat-compat.so: no faccessat2 syscall on 5.4; both display stacks LD_PRELOAD it.
	install -Dm755 "$builddir"/faccessat-compat.so \
		"$pkgdir"/usr/lib/faccessat-compat.so

	# Power key: short press toggles the backlight, long press powers off. The udev rule
	# hides the key from libinput, whose DPMS blank would kill the panel.
	install -Dm755 "$srcdir"/powerbutton-daemon "$pkgdir"/usr/bin/powerbutton-daemon
	install -Dm755 "$srcdir"/powerbutton.initd "$pkgdir"/etc/init.d/powerbutton
	install -Dm644 "$srcdir"/62-powerbutton-libinput.rules \
		"$pkgdir"/usr/lib/udev/rules.d/62-powerbutton-libinput.rules
	install -Dm755 "$builddir"/qpnp-volume-relay "$pkgdir"/usr/sbin/qpnp-volume-relay
	install -Dm755 "$srcdir"/qpnp-volume-relay.initd "$pkgdir"/etc/init.d/qpnp-volume-relay

	# check-apk-perms: diagnoses a rootfs whose ownership and setuid bits were rewritten.
	install -Dm755 "$srcdir"/check-apk-perms "$pkgdir"/usr/bin/check-apk-perms

	# audio-up: manual audio recovery; see the script and 72-audio-bringup.start.
	install -Dm755 "$srcdir"/audio-up "$pkgdir"/usr/bin/audio-up

	# UCM: the directory is the ALSA driver name (lahaina-yupikid, 15 chars), the master
	# file is the card longname, and File entries resolve relative to that directory.
	install -Dm644 "$srcdir"/samsung-gts7fewifi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/lahaina-yupikid/lahaina-yupikidp-snd-card.conf
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/lahaina-yupikid/HiFi.conf

	# xfce4-panel layout with the power buttons; xfce4-panel owns panel/default.xml,
	# this xfconf path is unowned.
	install -Dm644 "$srcdir"/xfce4-panel.xml \
		"$pkgdir"/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml

	# labwc reaches the GPU where Xorg (fbdev only) cannot; autostart ships in /etc/skel
	# because a bare labwc session has no way in without keyboard or right-click.
	install -Dm755 "$srcdir"/labwc-autostart "$pkgdir"/etc/skel/.config/labwc/autostart
	install -Dm644 "$srcdir"/labwc-menu.xml  "$pkgdir"/etc/skel/.config/labwc/menu.xml
	install -Dm644 "$srcdir"/labwc-rc.xml    "$pkgdir"/etc/skel/.config/labwc/rc.xml


	# Modules udev cannot autoload: wez01 (S Pen digitizer) defers probe, slimbus_ngd has no
	# MODULE_DEVICE_TABLE (no sound card without it), pinctrl_lpi_dlkm has no modalias match.
	install -Dm644 /dev/stdin "$pkgdir"/usr/lib/modules-load.d/gts7fewifi.conf <<-EOF
		wlan
		focaltech_ts_ft820x
		wez01
		slimbus_ngd
		hci_uart
		pinctrl_lpi_dlkm
	EOF

	# Camera bridge: drives camera.qcom.so directly and feeds /dev/video10. Files live in
	# /usr/lib/pmos-camera; camera-stack.sh copies them into the unpackaged Android tree.
	install -Dm644 "$srcdir"/libselinux_shim.so \
		"$pkgdir"/usr/lib/pmos-camera/libselinux_shim.so
	install -Dm644 "$srcdir"/libpmos_props.so \
		"$pkgdir"/usr/lib/pmos-camera/libpmos_props.so
	install -Dm644 "$srcdir"/libbridge.so \
		"$pkgdir"/usr/lib/pmos-camera/libbridge.so
	install -Dm644 "$srcdir"/pmos-props.conf \
		"$pkgdir"/usr/lib/pmos-camera/pmos-props.conf
	install -Dm644 "$srcdir"/vintf-manifest.xml \
		"$pkgdir"/usr/lib/pmos-camera/vintf-manifest.xml
	install -Dm644 "$srcdir"/vintf-framework-manifest.xml \
		"$pkgdir"/usr/lib/pmos-camera/vintf-framework-manifest.xml
	install -Dm644 "$srcdir"/camxoverridesettings.txt \
		"$pkgdir"/usr/lib/pmos-camera/camxoverridesettings.txt
	install -Dm755 "$srcdir"/camera-stack.sh \
		"$pkgdir"/usr/lib/pmos-camera/camera-stack.sh
	install -Dm755 "$srcdir"/camera-bridge \
		"$pkgdir"/usr/lib/pmos-camera/camera-bridge
	install -Dm755 "$srcdir"/logdw-sink.py \
		"$pkgdir"/usr/lib/pmos-camera/logdw-sink.py
	install -Dm755 "$srcdir"/logdw-listen.py \
		"$pkgdir"/usr/lib/pmos-camera/logdw-listen.py
	install -Dm755 "$srcdir"/camera-bridge.initd \
		"$pkgdir"/etc/init.d/camera-bridge
	install -Dm755 "$srcdir"/logdw-sink.initd \
		"$pkgdir"/etc/init.d/logdw-sink
	install -Dm644 "$srcdir"/camera-bridge.confd \
		"$pkgdir"/etc/conf.d/camera-bridge

	# Samsung HIDL camera provider, shipped but not enabled: it fights the bridge for the sensor.
	install -Dm755 "$srcdir"/android-camera.initd \
		"$pkgdir"/etc/init.d/android-camera
	install -Dm644 "$srcdir"/62-video.rules \
		"$pkgdir"/usr/lib/udev/rules.d/62-video.rules
	install -Dm644 "$srcdir"/v4l2loopback-modules.conf \
		"$pkgdir"/usr/lib/modules-load.d/v4l2loopback.conf
	install -Dm644 "$srcdir"/v4l2loopback-modprobe.conf \
		"$pkgdir"/usr/lib/modprobe.d/v4l2loopback.conf
	install -Dm644 "$srcdir"/ld.config.txt \
		"$pkgdir"/linkerconfig/ld.config.txt

	# Linux security hardening: kernel sysctls and sshd configuration
	install -Dm644 "$srcdir"/sysctl-99-security.conf \
		"$pkgdir"/usr/lib/sysctl.d/99-security.conf
	install -Dm644 "$srcdir"/sshd-50-security.conf \
		"$pkgdir"/etc/ssh/sshd_config.d/50-security.conf
	install -Dm644 "$srcdir"/modprobe-50-security-blacklist.conf \
		"$pkgdir"/usr/lib/modprobe.d/50-security-blacklist.conf
	install -Dm644 "$srcdir"/limits-10-disable-coredump.conf \
		"$pkgdir"/etc/security/limits.d/10-disable-coredump.conf
	install -Dm755 "$srcdir"/battery-protect \
		"$pkgdir"/usr/libexec/battery-protect
	install -Dm755 "$srcdir"/battery-protect.initd \
		"$pkgdir"/etc/init.d/battery-protect
	install -Dm644 "$srcdir"/battery-protect.conf \
		"$pkgdir"/usr/share/battery-protect/battery-protect.conf
	install -Dm644 "$srcdir"/sysctl-98-memory-tuning.conf \
		"$pkgdir"/usr/lib/sysctl.d/98-memory-tuning.conf
	install -Dm644 "$srcdir"/65-sec-epen.hwdb \
		"$pkgdir"/usr/lib/udev/hwdb.d/65-sec-epen.hwdb
	install -Dm644 "$srcdir"/fonts-local.conf \
		"$pkgdir"/etc/fonts/local.conf

	# Files of the -xorg subpackage. xorg() moves them out with amove.
	install -Dm755 "$builddir"/noblank.so "$pkgdir"/usr/lib/noblank.so
	install -Dm644 "$srcdir"/conf.d-lightdm "$pkgdir"/etc/conf.d/lightdm
	# Drop-in: lightdm owns /etc/lightdm/lightdm.conf.
	install -Dm644 "$srcdir"/lightdm.conf \
		"$pkgdir"/etc/lightdm/lightdm.conf.d/99-gts7fewifi.conf

	# Drop-in: lightdm-gtk-greeter owns /etc/lightdm/lightdm-gtk-greeter.conf.
	install -Dm644 "$srcdir"/lightdm-gtk-greeter.conf \
		"$pkgdir"/etc/lightdm/lightdm-gtk-greeter.conf.d/99-gts7fewifi.conf
	install -Dm644 "$srcdir"/xdg-autostart-noblank.desktop \
		"$pkgdir"/etc/xdg/autostart/00-noblank.desktop
	install -Dm644 "$srcdir"/xorg-10-noblank.conf \
		"$pkgdir"/usr/share/X11/xorg.conf.d/10-noblank.conf
	install -Dm644 "$srcdir"/xorg-20-fbdev.conf \
		"$pkgdir"/usr/share/X11/xorg.conf.d/20-fbdev.conf

	# Files of the -wayland subpackage. wayland() moves them out with amove.
	install -Dm644 "$srcdir"/weston.ini "$pkgdir"/etc/xdg/weston/weston.ini

	# Files of the -phosh subpackage. phosh() moves them out with amove.
	install -Dm755 "$srcdir"/phosh-session-gts7fewifi \
		"$pkgdir"/usr/bin/phosh-session-gts7fewifi
	install -Dm755 "$srcdir"/phrog-greeter-gts7fewifi \
		"$pkgdir"/usr/bin/phrog-greeter-gts7fewifi

	# greetd-phrog owns /etc/phrog/greetd-config.toml: ship the device config at its own
	# path and point /etc/conf.d/greetd (shipped by -phosh-openrc) at it.
	install -Dm644 "$srcdir"/phosh-greetd-config.toml \
		"$pkgdir"/etc/greetd/gts7fewifi-phosh.toml
	install -Dm644 "$srcdir"/conf.d-greetd "$pkgdir"/etc/conf.d/greetd

	# Session entry pointing at the device wrapper (replaces the phosh copy).
	install -Dm644 "$srcdir"/wayland-sessions-phosh.desktop \
		"$pkgdir"/usr/share/wayland-sessions/phosh.desktop

	# Without this PAM service the lockscreen rejects every passcode.
	install -Dm644 "$srcdir"/pam.d-phosh "$pkgdir"/usr/lib/pam.d/phosh

	# The greetd autologin session is not polkit-active; without this rule NetworkManager
	# refuses every UI action.
	install -Dm644 "$srcdir"/polkit-50-user.rules \
		"$pkgdir"/usr/share/polkit-1/rules.d/50-gts7fewifi-user.rules

	# Needed by the rule above: polkitd cannot validate unix-process subjects on this
	# kernel until the dumpable flag survives its privilege drop.
	install -Dm644 "$srcdir"/sysctl-50-polkit-pidfd.conf \
		"$pkgdir"/usr/lib/sysctl.d/50-gts7fewifi-polkit.conf

	# Suspend never resumes on this kernel and an uninhibited power key
	# means instant poweroff: block every path at the elogind level.
	install -Dm644 "$srcdir"/logind-40-gts7fewifi.conf \
		"$pkgdir"/etc/elogind/logind.conf.d/40-gts7fewifi.conf

	# System dconf defaults: never blank (the panel does not survive it), never lock.
	# The post-install runs dconf update.
	install -Dm644 "$srcdir"/dconf-profile-user \
		"$pkgdir"/etc/dconf/profile/user
	install -Dm644 "$srcdir"/dconf-00-noblank \
		"$pkgdir"/etc/dconf/db/local.d/00-gts7fewifi-noblank
	install -Dm644 "$srcdir"/dconf-10-no-lock \
		"$pkgdir"/etc/dconf/db/local.d/10-gts7fewifi-no-lock
	# The on-screen keyboard is the only keyboard; stevia stays hidden until this key is true.
	install -Dm644 "$srcdir"/dconf-20-osk.conf \
		"$pkgdir"/etc/dconf/db/local.d/20-gts7fewifi-osk
	# Power key suppressed at the desktop; qpnp_pon also carries volume down.
	install -Dm644 "$srcdir"/dconf-30-power.conf \
		"$pkgdir"/etc/dconf/db/local.d/30-gts7fewifi-power
	install -Dm644 "$srcdir"/dconf-35-wifi-only.conf \
		"$pkgdir"/etc/dconf/db/local.d/35-gts7fewifi-wifi-only
	install -Dm644 "$srcdir"/dconf-40-scale-to-fit \
		"$pkgdir"/etc/dconf/db/local.d/40-gts7fewifi-scale-to-fit
	install -Dm644 "$srcdir"/dconf-45-app-folders.conf \
		"$pkgdir"/etc/dconf/db/local.d/45-gts7fewifi-app-folders
	install -Dm644 "$srcdir"/dconf-50-window-buttons \
		"$pkgdir"/etc/dconf/db/local.d/50-gts7fewifi-window-buttons
	# Keyboard toggle launcher: the only way to type into X11 apps.
	install -Dm755 "$srcdir"/osk-toggle "$pkgdir"/usr/bin/osk-toggle
	install -Dm644 "$srcdir"/osk-toggle.desktop \
		"$pkgdir"/usr/share/applications/osk-toggle.desktop
	# dconf lock: the OSK key must not be shadowable from the user db.
	install -Dm644 "$srcdir"/dconf-locks-lock \
		"$pkgdir"/etc/dconf/db/local.d/locks/10-gts7fewifi-lock
	install -Dm644 "$srcdir"/dconf-locks-osk \
		"$pkgdir"/etc/dconf/db/local.d/locks/20-gts7fewifi-osk
	install -Dm644 "$srcdir"/dconf-locks-power \
		"$pkgdir"/etc/dconf/db/local.d/locks/30-gts7fewifi-power
	install -Dm644 "$srcdir"/dconf-locks-wifi-only \
		"$pkgdir"/etc/dconf/db/local.d/locks/35-gts7fewifi-wifi-only
	install -Dm644 "$srcdir"/gtk3-hide-cellular.css \
		"$pkgdir"/etc/gtk-3.0/gtk.css
	# Display scaling and Phoc config: 1.5x scale (1706x1067)
	install -Dm644 "$srcdir"/phoc.ini \
		"$pkgdir"/etc/phosh/phoc.ini
}

# Xorg issues FBIOBLANK during setup, which kills the panel: noblank.so is LD_PRELOADed
# through /etc/conf.d/lightdm, since xorg-server owns and overwrites any Xorg wrapper.
xorg() {
	pkgdesc="Xorg display fix for gts7fewifi: the panel dies on FBIOBLANK"
	install_if="$pkgname=$pkgver-r$pkgrel xorg-server"
	depends="
		lightdm
		lightdm-gtk-greeter
		xf86-video-fbdev
		xorg-server
		xrandr
		xset
	"
	amove usr/lib/noblank.so \
		etc/lightdm \
		etc/xdg/autostart/00-noblank.desktop \
		usr/share/X11/xorg.conf.d
}

xorg_openrc() {
	pkgdesc="$pkgdesc (OpenRC files for -xorg)"
	install_if="$pkgname-xorg=$pkgver-r$pkgrel openrc"
	depends=""
	amove etc/conf.d/lightdm
}

# Weston and labwc run on the Adreno via zink/Turnip; needs the two SDE IN_FORMATS
# kernel patches and seatd for DRM master.
wayland() {
	pkgdesc="Wayland route for gts7fewifi: Weston on the Adreno via zink/Turnip"
	install_if="$pkgname=$pkgver-r$pkgrel weston"
	depends="seatd weston weston-backend-drm weston-shell-desktop"
	amove etc/xdg/weston
}

# Phosh session fixes: stock postmarketos-ui-phosh does not reach a desktop on this device.
phosh() {
	pkgdesc="Phosh session for gts7fewifi (greetd, PAM, XDG, faccessat, no-BT)"
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-phosh"
	# seatd: phoc cannot take DRM master without it and the phosh packages do not pull it in.
	depends="polkit seatd"
	replaces="phosh"
	amove usr/bin/phosh-session-gts7fewifi \
		usr/bin/phrog-greeter-gts7fewifi \
		etc/greetd \
		usr/lib/pam.d \
		usr/share/polkit-1 \
		usr/lib/sysctl.d/50-gts7fewifi-polkit.conf \
		etc/elogind \
		etc/dconf \
		usr/bin/osk-toggle \
		usr/share/applications \
		etc/gtk-3.0 \
		usr/share/wayland-sessions \
		etc/phosh
}

# Ships /etc/conf.d/greetd pointed at the device session config; the post-install sets runlevels.
phosh_openrc() {
	pkgdesc="$pkgdesc (OpenRC setup for -phosh)"
	install_if="$pkgname-phosh=$pkgver-r$pkgrel openrc"
	depends=""
	replaces="postmarketos-ui-phosh-openrc greetd-openrc"
	amove etc/conf.d/greetd
}

