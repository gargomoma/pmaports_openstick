d9090744a5c8dda1fc1a6d3e3a2b14a3759b850a872080791f7156fcec1f4df3b39e0cfc48d919217a8971627f67a6c5adb6ea95f86a345d97ea6c175e0aaa42  config-postmarketos-qcom-sdm670.aarch64
"
