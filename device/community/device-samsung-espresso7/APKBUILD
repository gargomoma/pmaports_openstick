# Reference: <https://postmarketos.org/devicepkg>
# Co-Maintainer: Antoni Aloy <aaloytorrens@gmail.com>
maintainer="Mithil Bavishi <bavishimithil@gmail.com>"
pkgname=device-samsung-espresso7
pkgdesc="Samsung Galaxy Tab 2 (7.0 inch)"
pkgver=10
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	firmware-samsung-espresso
	linux-postmarketos-omap
	mkbootimg
	postmarketos-base
	"
makedepends="devicepkg-dev"
subpackages="$pkgname-wayland"
source="
	deviceinfo
	etc-profile.d-25wlr-pixman.sh
"
replaces="device-samsung-espresso3g"
provides="device-samsung-espresso3g=$pkgver-r$pkgrel"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

wayland() {
	# This is only useful on wlroots, but it has too many verions in Alpine
	# at the moment to come up with a sane install_if
	install_if="$pkgname=$pkgver-r$pkgrel wayland-libs-server"
	install -D -m644 "$srcdir"/etc-profile.d-25wlr-pixman.sh \
		"$subpkgdir"/etc/profile.d/25wlr-pixman.sh
}

