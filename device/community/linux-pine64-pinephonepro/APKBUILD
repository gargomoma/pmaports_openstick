	mpc1-dev
	mpfr-dev
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	rsync
	xz
	zstd
	"

case "$CARCH" in
	aarch64*) _carch="arm64" ;;
	arm*) _carch="arm" ;;
esac

# cherry-picking from megi tree
#
#    git clone https://codeberg.org/megi/linux.git --branch orange-pi-7.2
#    cd linux
#    git switch -c ppp-7.2
#    git reset --hard 8d3ae59288f1e7d58d76558a6ee96d533bc5019f   # v7.2
#
# group by feature
#
#    mkdir -p /tmp/ppp
#    cat > /tmp/ppp/audio <<'EOF'
#    ASoC: codecs: rt5640: Fix hpout restore when lout is enabled
#    ASoC: codecs: rt5640: Keep the codec enabled when idle
#    ASoC: rockchip: Fix doubling of playback speed after system sleep
#    arm64: dts: rockchip: rk3399-pinephone-pro: Add sound support
#    EOF
#
#    cat > /tmp/ppp/battery <<'EOF'
#    power: supply: rk818_battery: Add battery charger driver for RK818
#    power: supply: rk818_battery: Don't override configured charger limits in probe
#    power: supply: rk818_battery: Scale charge current by the sense resistor value
#    power: supply: rk818_battery: Scale termination current by the sense resistor value
#    power: supply: rk818_battery: Compensate for IR drop when detecting an empty battery
#    power: supply: rk818_battery: Rework the low voltage monitor setup
#    usb: typec: fusb302: Slightly increase wait time for BC1.2 result
#    usb: typec: fusb302: Add OF extcon support
#    arm64: dts: rockchip: rk3399-pinephone-pro: Add battery charger support
#    phy: rockchip-inno-usb2: Decrease delay between port init and charger detection
#    phy: rockchip-inno-usb2: Set up charger detection mode on RK3399
#    EOF
#
#    cat > /tmp/ppp/camera <<'EOF'
#    media: imx258: Add reset gpio
#    media: imx258: Drop interface speed to 1224 mbps
#    EOF
#
#    cat > /tmp/ppp/connectivity <<'EOF'
#    mfd: rk8xx: Enable rk808-clkout2 function
#    arm64: dts: rockchip: rk3399-pinephone-pro: Add modem support
#    arm64: dts: rockchip: rk3399-pinephone-pro: Disable interrupt GPIO for WiFi for the Pinephone Pro
#    EOF
#
#    cat > /tmp/ppp/external-dock-and-display <<'EOF'
#    arm64: dts: rockchip: rk3399: Number the CDN DP ports
#    phy: rockchip-typec: Support a Type-C mode mux
#    phy: rockchip-typec: Publish the DP lane count
#    drm/rockchip: cdn-dp: Support ports driven by a Type-C PHY
#    usb: typec: displayport: Update the mux before signalling hotplug
#    EOF
#
#    cat > /tmp/ppp/usb-c <<'EOF'
#    arm64: dts: rockchip: rk3399-pinephone-pro: Add Type-C port support
#    phy: rockchip-typec: Support a Type-C orientation switch
#    phy: rockchip-inno-usb2: Learn the host role from phy_set_mode()
#    phy: rockchip-inno-usb2: Do not run charger detection as a host
#    usb: dwc3: Set the PHY mode before starting the host
#    phy: rockchip-inno-usb2: Power the PHY up before the host starts
#    EOF
#
# cherry-pick
#
#    cat /tmp/ppp/* | sort > /tmp/ppp-want
#
#    git log --format=%s HEAD..orange-pi-7.2 | sort > /tmp/ppp-have
#    comm -23 /tmp/ppp-want /tmp/ppp-have
#
#    touch /tmp/ppp-picks
#    git log --reverse --format="%H %s" HEAD..orange-pi-7.2 |
#    while read -r sha subject; do
#        grep -qxF "$subject" /tmp/ppp-want && echo "$sha" >> /tmp/ppp-picks
#    done
#
#    git cherry-pick $(cat /tmp/ppp-picks)
#
# keep modem powered
#
#    git am --ignore-whitespace <<'PATCH'
#    From: Dummy <dummy@gmail.com>
#    Subject: [PATCH] arm64: dts: rk3399-pinephone-pro: Keep modem regulators always-on
#
#    The vcc_4g and vcc_4g_5v regulators power the EG25 modem. Mark them
#    always-on so the modem is powered at boot when using eg25-manager.
#    ---
#     arch/arm64/boot/dts/rockchip/rk3399-pinephone-pro.dts | 2 ++
#     1 file changed, 2 insertions(+)
#
#    diff --git a/arch/arm64/boot/dts/rockchip/rk3399-pinephone-pro.dts b/arch/arm64/boot/dts/rockchip/rk3399-pinephone-pro.dts
#    --- a/arch/arm64/boot/dts/rockchip/rk3399-pinephone-pro.dts
#    +++ b/arch/arm64/boot/dts/rockchip/rk3399-pinephone-pro.dts
#    @@ -429,6 +429,7 @@
#            regulator-min-microvolt = <5000000>;
#            regulator-max-microvolt = <5000000>;
#            vin-supply = <&vcc5v0_sys>;
#    +       regulator-always-on;
#        };
#
#        vcc_4g: regulator-vcc-4g {
#    @@ -441,6 +442,7 @@
#            regulator-min-microvolt = <3800000>;
#            regulator-max-microvolt = <3800000>;
#            vin-supply = <&vcc_sys>;
#    +       regulator-always-on;
#        };
#
#        vcc1v8_codec: regulator-vcc1v8-codec {
#    PATCH
#
# write each patch into its directory. --start-number keeps numbering
# continuous across all of them, so apply order stays numeric order.
#
#    n=1
#    git log --reverse --format='%H %s' 8d3ae59288f1..HEAD |
#    while read -r sha subject; do
#        dir=$(basename "$(grep -lxF "$subject" /tmp/ppp/*)")
#        git format-patch -1 --start-number $n -o "megi_patches/$dir" $sha
#        n=$((n + 1))
#    done

# Source
_config="config-$_flavor.$CARCH"
case $pkgver in
	*.*.*)	_kernver=${pkgver%.0};;
	*.*)	_kernver=$pkgver;;
esac
source="
	https://cdn.kernel.org/pub/linux/kernel/v${_kernver%%.*}.x/linux-${pkgver//_/-}.tar.xz
	config-$_flavor.aarch64
	megi_patches/camera/0001-media-imx258-Add-reset-gpio.patch
	megi_patches/camera/0002-media-imx258-Drop-interface-speed-to-1224-mbps.patch
	megi_patches/audio/0003-ASoC-codecs-rt5640-Fix-hpout-restore-when-lout-is-en.patch
	megi_patches/audio/0004-ASoC-codecs-rt5640-Keep-the-codec-enabled-when-idle.patch
	megi_patches/audio/0005-ASoC-rockchip-Fix-doubling-of-playback-speed-after-s.patch
	megi_patches/connectivity/0006-mfd-rk8xx-Enable-rk808-clkout2-function.patch
	megi_patches/battery/0007-power-supply-rk818_battery-Add-battery-charger-drive.patch
	megi_patches/battery/0008-power-supply-rk818_battery-Don-t-override-configured.patch
	megi_patches/battery/0009-power-supply-rk818_battery-Scale-charge-current-by-t.patch
	megi_patches/battery/0010-power-supply-rk818_battery-Scale-termination-current.patch
	megi_patches/battery/0011-power-supply-rk818_battery-Compensate-for-IR-drop-wh.patch
	megi_patches/battery/0012-power-supply-rk818_battery-Rework-the-low-voltage-mo.patch
	megi_patches/battery/0013-usb-typec-fusb302-Slightly-increase-wait-time-for-BC.patch
	megi_patches/battery/0014-usb-typec-fusb302-Add-OF-extcon-support.patch
	megi_patches/external-dock-and-display/0015-arm64-dts-rockchip-rk3399-Number-the-CDN-DP-ports.patch
	megi_patches/usb-c/0016-arm64-dts-rockchip-rk3399-pinephone-pro-Add-Type-C-p.patch
	megi_patches/battery/0017-arm64-dts-rockchip-rk3399-pinephone-pro-Add-battery-.patch
	megi_patches/audio/0018-arm64-dts-rockchip-rk3399-pinephone-pro-Add-sound-su.patch
	megi_patches/connectivity/0019-arm64-dts-rockchip-rk3399-pinephone-pro-Add-modem-su.patch
	megi_patches/connectivity/0020-arm64-dts-rockchip-rk3399-pinephone-pro-Disable-inte.patch
	megi_patches/battery/0021-phy-rockchip-inno-usb2-Decrease-delay-between-port-i.patch
	megi_patches/battery/0022-phy-rockchip-inno-usb2-Set-up-charger-detection-mode.patch
	megi_patches/usb-c/0023-phy-rockchip-typec-Support-a-Type-C-orientation-swit.patch
	megi_patches/external-dock-and-display/0024-phy-rockchip-typec-Support-a-Type-C-mode-mux.patch
	megi_patches/external-dock-and-display/0025-phy-rockchip-typec-Publish-the-DP-lane-count.patch
	megi_patches/external-dock-and-display/0026-drm-rockchip-cdn-dp-Support-ports-driven-by-a-Type-C.patch
	megi_patches/usb-c/0027-phy-rockchip-inno-usb2-Learn-the-host-role-from-phy_.patch
	megi_patches/usb-c/0028-phy-rockchip-inno-usb2-Do-not-run-charger-detection-.patch
	megi_patches/usb-c/0029-usb-dwc3-Set-the-PHY-mode-before-starting-the-host.patch
	megi_patches/usb-c/0030-phy-rockchip-inno-usb2-Power-the-PHY-up-before-the-h.patch
	megi_patches/external-dock-and-display/0031-usb-typec-displayport-Update-the-mux-before-signalli.patch
	0032-arm64-dts-rk3399-pinephone-pro-Keep-modem-regulators.patch
	"
builddir="$srcdir/linux-${_kernver//_/-}"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$CARCH" "$builddir"/.config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))"

}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs-$_flavor
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}


